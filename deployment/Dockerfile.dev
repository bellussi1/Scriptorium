FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir pytest pytest-asyncio

COPY src/ ./src/
COPY tests/ ./tests/
COPY benchmark/ ./benchmark/
COPY scripts/ ./scripts/
COPY literary-resources/ ./literary-resources/
COPY Custom_Instructions/ ./Custom_Instructions/
COPY pytest.ini ./
COPY translate.py translation_api.py launcher.py ./

RUN useradd --create-home --uid 1000 app && \
    mkdir -p /app/data/uploads /app/logs /app/translated_files /app/Custom_Instructions /app/state && \
    chown -R app:app /app

USER app

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

CMD ["python", "translation_api.py"]
